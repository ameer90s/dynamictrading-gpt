# Market data
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# PRIMARY NON-API SHARIA SOURCE MANAGEMENT
# Used only to protect importing a verified AAOIFI CSV/JSON snapshot into the local Netlify Blobs database.
# The scanner reads the local database without external Sharia API calls or credits.
SHARIA_ADMIN_TOKEN=replace_with_long_random_secret

# Optional helper refresh source. Not required for scanner continuity when local Sharia DB is populated.
HALAL_TERMINAL_API_KEY=

# Controlled emergency fallback only; never auto-label unknown symbols.
SHARIA_UNIVERSE=
SHARIA_UNIVERSE_UPDATED_AT=

# Dynamic Trading 3.6 independent AI-PAPER research scanner
# Default: 12 symbols per scheduled minute, rotating the eligible Sharia pool.
# Increase only after verifying Netlify execution limits & Alpaca plan quotas.
AI_PARALLEL_CYCLE_CAP=12

# Optional, paid, background LLM RESEARCH commentary. OFF unless explicitly enabled.
# Do NOT put API keys in the public/ folder; configure server-side in Netlify.
AI_LLM_REVIEW_ENABLED=false
OPENAI_RESEARCH_API_KEY=
OPENAI_RESEARCH_MODEL=

# 3.7 monthly OpenAI Research Pilot. Keep false until the approved deployment.
OPENAI_RESEARCH_ENABLED=false
OPENAI_RESEARCH_MODEL=gpt-6.1-terra
# OPENAI_RESEARCH_API_KEY is shared above; store the key in Netlify Functions environment only.
# AI_LLM_REVIEW_ENABLED must stay false to avoid duplicate model charges.
